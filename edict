function concatenate_args {
	string=""
	for a in "$@"
	do
		if [[ "$string" != "" ]]
		then
			string+="%20"
		fi
		string+="$a"
	done
	echo "$string"
}

PKGFOLDER=~/.edict

if [ ! -d "$PKGFOLDER/venv" ]; then
    python3 -m venv "$PKGFOLDER/venv"
    source "$PKGFOLDER/venv/bin/activate"
    pip install beautifulsoup4 openai
else
    source "$PKGFOLDER/venv/bin/activate"
fi

args="$(concatenate_args "$@")"
tPage=$args
exeName=$0
exeName=${exeName##*/}
exeName=${exeName%.*}
exeName=$exeName.py
python3 $PKGFOLDER/$exeName $tPage
